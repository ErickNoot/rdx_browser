<Window x:Class="Rdx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="rdx" Height="720" Width="1100"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBlack}">
    <!-- estende o conteudo pra area da title bar: abas + botoes viram UMA barra so -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- ===== abas + botoes da janela numa linha so ===== -->
        <Border Grid.Row="0" Background="{StaticResource BgBlack}" BorderThickness="0,0,0,1" BorderBrush="#2A2138">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="MinButton" Content="—" ToolTip="Minimizar"
                            Style="{StaticResource ChromeButton}" Click="MinButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MaxButton" Content="▢" ToolTip="Maximizar"
                            Style="{StaticResource ChromeButton}" Click="MaxButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="CloseButton" Content="✕" ToolTip="Fechar"
                            Style="{StaticResource CloseButton}" Click="CloseButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
                <Button x:Name="NewTabButton" DockPanel.Dock="Right" Content="+" ToolTip="Nova aba (Ctrl+T)"
                        Style="{StaticResource PlusButton}" Click="NewTabButton_Click" Margin="0,0,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== barra de navegacao ===== -->
        <Border Grid.Row="1" Background="{StaticResource BgBar}" Padding="6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Content="←" ToolTip="Voltar" Style="{StaticResource NavButton}" Click="BackButton_Click"/>
                    <Button x:Name="ForwardButton" Content="→" ToolTip="Avançar" Style="{StaticResource NavButton}" Click="ForwardButton_Click"/>
                    <Button x:Name="ReloadButton" Content="⟳" ToolTip="Recarregar (F5)" Style="{StaticResource NavButton}" Click="ReloadButton_Click"/>
                    <Button x:Name="HomeButton" Content="⌂" ToolTip="Início" Style="{StaticResource NavButton}" Click="HomeButton_Click"/>
                </StackPanel>

                <Border Grid.Column="4" Background="{StaticResource BgField}" CornerRadius="6"
                        Height="30" VerticalAlignment="Center" Margin="6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Omnibox" Grid.Column="0" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource FgText}" CaretBrush="{StaticResource FgGreen}"
                                 VerticalContentAlignment="Center" Padding="10,0" FontSize="13"
                                 KeyDown="Omnibox_KeyDown" GotFocus="Omnibox_GotFocus"/>
                        <TextBlock x:Name="OmniboxHint" Grid.Column="0" Text="buscar ou digitar endereço"
                                   Foreground="{StaticResource FgMuted}" FontSize="13"
                                   VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ShieldButton" Content="⛨" ToolTip="Bloqueador de anúncios: ligado"
                            Style="{StaticResource NavButton}" Click="ShieldButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== conteudo (WebViews entram aqui, uma por aba) ===== -->
        <Grid Grid.Row="2" x:Name="WebHost" Background="#111111"/>

        <!-- ===== status minimalista ===== -->
        <Border Grid.Row="3" Background="{StaticResource BgBlack}" BorderThickness="0,1,0,0" BorderBrush="#2A2138">
            <TextBlock x:Name="StatusText" Text="rdx • pronto" Foreground="{StaticResource FgMuted}"
                       FontSize="11" VerticalAlignment="Center" Margin="8,0"/>
        </Border>
    </Grid>
</Window>
